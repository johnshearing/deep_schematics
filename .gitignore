# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Node / frontend (webui, once it exists)
node_modules/
dist/
.vite/

# Vite build output served by FastAPI — a build artifact, never committed.
# See _claude_notes/webui_v1_plan.md §5.
server/app/static/

# Local configuration and secrets. The webserver will read ANTHROPIC_API_KEY
# and the SWUI_* settings from a .env that must never be committed.
.env
.env.*
!.env.example

# Server runtime state: the daily spend ledger and the per-turn raw transcripts. The
# transcripts are an audit artifact, but they are also visitor text and they grow without
# bound, so they stay local. Curated acceptance runs go in _claude_notes/webui_acceptance/.
server/.state/

# Node test/build caches
webui/node_modules/.tmp/

# Claude Code local state
.claude/settings.local.json

# OS noise
.DS_Store
Thumbs.db
