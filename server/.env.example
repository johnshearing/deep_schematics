# Copy to server/.env. Every setting is optional — the defaults below are the defaults in
# app/config.py. Nothing in here is secret unless you set ANTHROPIC_API_KEY or a password.

# --- what we answer questions about -------------------------------------------------------
# The child's cwd, and the only directory it is allowed to read.
#SWUI_DRAWING_DIR=/home/js/schematics/schematic_extraction/PS20115MLM4-2/extracted_docs

# --- model ---------------------------------------------------------------------------------
#SWUI_CLAUDE_BIN=claude
# Measured (plan §1.6): Opus ~$0.64 / ~110 s, Sonnet ~$0.16 / ~60 s, and Sonnet still gets the
# hard troubleshooting question right. Sonnet is the default for that reason.
#SWUI_DEFAULT_MODEL=sonnet
#SWUI_ALLOWED_MODELS=opus,sonnet
# Which models a visitor may use *without* the password. Leave `sonnet` here for a public demo
# where anyone may try the cheap model. Set it empty — `SWUI_ANONYMOUS_MODELS=` with nothing
# after it — to require the password for every question.
#SWUI_ANONYMOUS_MODELS=sonnet
#SWUI_MAX_BUDGET_USD=1.50
#SWUI_TURN_TIMEOUT_S=420

# --- cost control (plan §3.2) ----------------------------------------------------------------
#SWUI_DAILY_SPEND_CEILING_USD=10.00
#SWUI_RATE_LIMIT=3/10 minutes
#SWUI_MAX_CONCURRENT_TURNS=2
#SWUI_MAX_TURNS_PER_SESSION=20

# --- abuse plan, off by default (plan §3.5) --------------------------------------------------
# Set this and the UI asks for it before allowing a non-anonymous model. Restart to apply.
#SWUI_DEMO_PASSWORD=
# Guesses per IP per minute against /api/unlock. A short password relies on this entirely.
#SWUI_UNLOCK_RATE_LIMIT=5/minute

# --- serving -----------------------------------------------------------------------------
#SWUI_HOST=127.0.0.1
#SWUI_PORT=9700
# Set to an empty value in production: the built frontend is same-origin under /webui.
#SWUI_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- going public (plan §3.1) -----------------------------------------------------------------
# The structural fix for the §1.3 escape: run as a dedicated unix user whose HOME contains no
# .claude.json, and authenticate with an API key that has a spend cap in the console rather
# than with the personal OAuth subscription.
#SWUI_CHILD_HOME=/home/schematicbot
#ANTHROPIC_API_KEY=
